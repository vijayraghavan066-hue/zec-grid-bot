# Binance.US API credentials - trading permission only, NO withdrawal permission.
# Same account as the DASH/XRP/UNI/HBAR bots (keys are account-scoped, not
# symbol-scoped), but this is a fully separate .env/state/service - changes
# here never touch them.
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=

# Market. ZECUSDT chosen over ZECUSD: ~10x more liquid ($221k vs $21.7k
# median daily quote volume), longer trading history (~400 days vs ~108),
# and higher/more consistent volatility (117.5% annualized, 99.6% of
# 7-day windows measured as genuinely choppy rather than trending) --
# screened against the full Binance.US universe before picking ZEC itself.
SYMBOL=ZECUSDT

GRID_MODE=hybrid
PILOT_POINTS=

# Old hybrid anchor+dense grid shape -- INERT, same as UNI's build. The
# live structure is exclusively the percentage-ladder system below
# (PCT_LADDER_ENABLED), built by build_zec_pct_ladders.py. ANCHOR_LOW is
# set deliberately far below the live price (~$1210 at build time, after
# roughly a 30x run over 13 months) -- real 30-40% pullbacks recur even
# within that uptrend, and a severe reversion risk (e.g. back toward
# $250) was explicitly flagged before this build. A tight anchor would
# leave the bot structurally unable to keep operating if price fell a
# long way; this keeps it able to keep following price down.
ANCHOR_LOW=200.00
ANCHOR_HIGH=2000.00
ANCHOR_STEP=50.0
DENSE_LOW=900.0
DENSE_HIGH=1300.0
DENSE_SELL_OFFSET=30.0
DENSE_STEP=5.0

# Inert placeholder -- real capital for the ladder build comes from the
# explicit amount passed to build_zec_pct_ladders.py, read against live
# free USDT at run time, not from this field. REFERENCE_PRICE is still
# live: it's pct_ladder.py's DCA weighting anchor -- update to the actual
# live price right before running the build script.
TOTAL_CAPITAL_USDT=0.01
REFERENCE_PRICE=1210.0
DCA_EXPONENT=1.0

# No bulk ladder.
BULK_AMOUNT_USDT=0
BULK_SELL_HIGH=2000.0
BULK_SELL_STEP=30.0

MAX_OPEN_ORDERS=180

# Proportional to ZEC's ~$1200 price and $0.01 tick -- roughly 0.25% of
# current price, similar proportion to DASH's $0.30 at its ~$55-60 scale.
TAKER_AVOIDANCE_BUFFER=3.0

# Zone-shift / dense-window retired along with the old hybrid design --
# off since bot.py has nothing left to read them, kept only as inert
# config (same as UNI/XRP's current state).
ZONE_SHIFT_ENABLED=false
ZONE_SHIFT_INTERVAL_HOURS=2
NEAR_MARKET_BAND_PCT=0.10
CONSOLIDATION_STEP=30.0
DENSE_WINDOW_ENABLED=false

# Safety switch. true = simulate orders only, no real trades placed.
DRY_RUN=true

PROFIT_RESERVE_RATIO=0.5
REINVEST_BAND_PCT=0.04

POLL_INTERVAL_SECONDS=120

STATE_FILE=state.json
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
HEARTBEAT_FILE=heartbeat.json
LEDGER_FILE=trades.csv

# Enabled by default here (unlike XRP/UNI's original off-by-default) --
# ZEC's crash risk was explicitly flagged before this build. Halts new
# buying during a fast decline, never touches existing sell_open
# positions, auto-resumes once price recovers CIRCUIT_BREAKER_RESUME_PCT
# off the low.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_DROP_PCT=0.15
CIRCUIT_BREAKER_WINDOW_HOURS=6
CIRCUIT_BREAKER_RESUME_PCT=0.05
ORDER_HEALTH_FILE=order_health.json

# pct_ladder.py: percentage-based 5-ladder system -- ZEC's live structure
# from day one, built by build_zec_pct_ladders.py. Same shape as
# XRP/UNI's (1%/2%/3%/4%/5% offsets, matching windows).
PCT_LADDER_ENABLED=true
LADDER1_STEP_PCT=0.01
LADDER1_OFFSET_PCT=0.01
LADDER1_WINDOW_PCT=0.05
LADDER2_STEP_PCT=0.02
LADDER2_OFFSET_PCT=0.02
LADDER2_WINDOW_PCT=0.10
LADDER3_STEP_PCT=0.03
LADDER3_OFFSET_PCT=0.03
LADDER3_WINDOW_PCT=0.15
LADDER4_STEP_PCT=0.04
LADDER4_OFFSET_PCT=0.04
LADDER4_WINDOW_PCT=0.20
LADDER5_STEP_PCT=0.05
LADDER5_OFFSET_PCT=0.05
LADDER5_WINDOW_PCT=0.25
RESERVED_DRAW_FLOOR_PCT=0.5
RESERVED_TOPUP_THRESHOLD_USD=5.0
COIN_RESERVE_PCT=0.10
COIN_GROWTH_PCT=0.20
